# Copy to .env and fill in. Never commit .env (see .gitignore).

# Database (D-18: sqlite now, postgres for pilot — same ORM, switch via this URL)
DATABASE_URL=sqlite:///./data/processed/suryasutra.db

# Data directories (D-13: vendor PDFs are downloaded locally, never committed)
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# LLM provider (D-21: behind an adapter, chosen by config).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
