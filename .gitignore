# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env

# Data (D-13: never redistribute vendor manuals; D-26: raw/processed are regenerable)
data/raw/*
!data/raw/.gitkeep
!data/raw/SOURCES.md
!data/raw/checksums.sha256
data/processed/*
!data/processed/.gitkeep

# Experiment outputs (D-26: keep summary, not every run)
eval/results/*
!eval/results/summary.md
!eval/results/summary_generation.md
!eval/results/.gitkeep

# Regenerable, non-authoritative hints (D-14) — never the gold labels themselves,
# which stay committed (data/eval/gold_labels.yaml, CLAUDE.md §8).
data/eval/system_suggestions.yaml

# Regenerable PDF exports of docs/*.md (`python md_to_pdf.py`, not committed to repo)
docs/pdf/

# Frontend
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/blob-report/

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
